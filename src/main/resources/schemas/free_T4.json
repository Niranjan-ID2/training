    "patientName": { "type": "string" },
    "patientAge": { "type": "integer", "minimum": 0 },
    "patientSex": { "type": "string" },
    "values": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["ng/dL", "pmol/L"] },
        "reference_range": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
