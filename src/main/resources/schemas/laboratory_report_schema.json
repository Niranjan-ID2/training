{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laboratory Report",
  "description": "Schema for validating laboratory reports",
  "type": "object",
  "properties": {
    "laboratory_report": {
      "type": "object",
      "properties": {
        "lab_code": {
          "type": "string",
          "format": "uuid",
          "description": "Unique code for the lab report, preferably UUID"
        },
        "lab_name": {
          "type": "string",
          "description": "Name of the laboratory"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the report"
        },
        "patient_information": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "integer", "minimum": 0 },
            "gender": { "type": "string" },
            "id": { "type": "string", "description": "Patient identifier" },
            "contact_information": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "address": { "type": "string" }
                },
                "required": ["email"]
              }
            }
          },
          "required": ["name", "age", "gender", "id"]
        },
        "test_information": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_type": { "type": "string" },
              "test_performed_date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "test_performed_time": { "type": "string", "format": "time", "pattern": "^\\d{2}:\\d{2}$" },
              "test_reported_date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "test_reported_time": { "type": "string", "format": "time", "pattern": "^\\d{2}:\\d{2}$" },
              "specimen": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "collection_method": { "type": "string" },
                  "collection_date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "collection_time": { "type": "string", "format": "time", "pattern": "^\\d{2}:\\d{2}$" }
                },
                "required": ["type", "collection_date", "collection_time"]
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "parameter": { "type": "string" },
                    "value": { "type": "string" },
                    "reference_range": {
                      "type": "object",
                      "properties": {
                        "min_range": { "type": "string" },
                        "max_range": { "type": "string" }
                      }
                    },
                    "units": { "type": "string" },
                    "comments": { "type": "string" }
                  },
                  "required": ["parameter", "value"]
                }
              },
              "interpretation": {
                "type": "object",
                "properties": {
                  "observations": { "type": "string" },
                  "critical_alerts": { "type": "string" },
                  "comments": { "type": "string" }
                }
              },
              "pathologist_lab_technician_information": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "contact": { "type": "string" }
                }
              }
            },
            "required": ["test_type", "specimen", "results"]
          }
        }
      },
      "required": ["lab_code", "lab_name", "patient_information", "test_information"]
    }
  },
  "required": ["laboratory_report"]
}
