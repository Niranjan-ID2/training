{
  "type": "object",
  "properties": {
    "reportDate": { "type": "string", "format": "date" },
    "labName": { "type": "string" },
    "patientName": { "type": "string" },
    "patientAge": { "type": "integer", "minimum": 0 },
    "patientSex": { "type": "string" },
    "values": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["ng/mL", "nmol/L"] },
        "interpretation": { "type": "string", "enum": ["Deficient", "Insufficient", "Sufficient", "Optimal", "Toxic"] }
        // Optional: Add reference_range
      },
      "required": ["value", "unit", "interpretation"]
    }
  },
  "required": ["reportDate", "labName", "patientName", "patientAge", "patientSex", "values"]
}
